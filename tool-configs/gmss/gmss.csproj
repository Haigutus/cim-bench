<!-- Stub project: `dotnet publish` collects the GridLab GMSS CIM DLLs
     (public on nuget.org) so pythonnet can load them at runtime. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GridLab.Gmss.Cim.Domain" Version="10.1.1.229" />
    <!-- ABP property injection (Logger etc.) only works with the Autofac provider -->
    <PackageReference Include="Volo.Abp.Autofac" Version="10.1.1" />
  </ItemGroup>

</Project>
